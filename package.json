{
  "name": "dsh-ps-preflight",
  "version": "0.1.0",
  "engines": { "dsh": ">=0.2.0-rc.2 <0.3.0" },
  "description": "Static pre-execution risk grading for agent-generated PowerShell: every command gets a tier by deletion / overwrite / download / credential touch, high risk asks for a second confirmation, and every verdict is written to a local audit log.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "powershell",
    "safety",
    "security",
    "audit",
    "preflight"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-ps-preflight.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-ps-preflight#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-ps-preflight/issues"
  },
  "license": "MIT"
}
